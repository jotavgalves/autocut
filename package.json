{
  "name": "autocut-electron",
  "version": "0.1.0",
  "description": "AUTOCUT - preparacao automatica de artes para sublimacao",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set AUTOCUT_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "validate:desktop": "node tests/validate-desktop-image.js",
    "build": "vite build"
  },
  "dependencies": {
    "electron": "^44.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  }
}
